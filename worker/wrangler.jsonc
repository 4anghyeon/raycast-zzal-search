{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zzal-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zzal-db",
      "database_id": "b385789b-ac8d-4154-b407-e0c3e9496c8d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zzal-files"
    }
  ]
}
