{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zzal-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zzal-db",
      "database_id": "b385789b-ac8d-4154-b407-e0c3e9496c8d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zzal-files"
    }
  ],
  // 이미지 변환은 로컬에서 에뮬레이션되지 않아 remote: true로 로컬 dev에서도 실제 서비스를 호출한다.
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
